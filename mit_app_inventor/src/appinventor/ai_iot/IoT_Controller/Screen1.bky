<xml xmlns="http://www.w3.org/1999/xhtml">
  <block type="global_declaration" id="var_server_url" x="20" y="20">
    <field name="NAME">server_url</field>
    <value name="VALUE">
      <block type="text" id="text_init_ip">
        <field name="TEXT">http://192.168.1.100:5000</field>
      </block>
    </value>
  </block>

  <block type="procedures_defnoreturn" id="proc_sendCommand" x="20" y="80">
    <field name="NAME">sendCommand</field>
    <field name="VAR0">endpoint</field>
    <statement name="STACK">
      <block type="component_set_get" id="set_web_url">
        <mutation component_type="Web" set_or_get="set" property_name="Url" is_generic="false" instance_name="Web1"></mutation>
        <field name="COMPONENT_SELECTOR">Web1</field>
        <field name="PROP">Url</field>
        <value name="VALUE">
          <block type="text_join" id="join_cmd_url">
            <mutation items="2"></mutation>
            <value name="ADD0">
              <block type="lexical_variable_get" id="get_srv_url">
                <field name="VAR">global server_url</field>
              </block>
            </value>
            <value name="ADD1">
              <block type="lexical_variable_get" id="get_ep">
                <field name="VAR">endpoint</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="component_method" id="call_post_text">
            <mutation component_type="Web" method_name="PostText" is_generic="false" instance_name="Web1"></mutation>
            <field name="COMPONENT_SELECTOR">Web1</field>
            <value name="ARG0">
              <block type="text" id="empty_post_body">
                <field name="TEXT"></field>
              </block>
            </value>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="procedures_defnoreturn" id="proc_requestStatus" x="20" y="260">
    <field name="NAME">requestStatus</field>
    <statement name="STACK">
      <block type="component_set_get" id="set_web_status_url">
        <mutation component_type="Web" set_or_get="set" property_name="Url" is_generic="false" instance_name="Web1"></mutation>
        <field name="COMPONENT_SELECTOR">Web1</field>
        <field name="PROP">Url</field>
        <value name="VALUE">
          <block type="text_join" id="join_status_url">
            <mutation items="2"></mutation>
            <value name="ADD0">
              <block type="lexical_variable_get" id="get_srv_status">
                <field name="VAR">global server_url</field>
              </block>
            </value>
            <value name="ADD1">
              <block type="text" id="status_ep">
                <field name="TEXT">/api/status</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="component_method" id="call_web_get">
            <mutation component_type="Web" method_name="Get" is_generic="false" instance_name="Web1"></mutation>
            <field name="COMPONENT_SELECTOR">Web1</field>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="component_event" id="screen_init" x="20" y="440">
    <mutation component_type="Form" is_generic="false" instance_name="Screen1" event_name="Initialize"></mutation>
    <field name="COMPONENT_SELECTOR">Screen1</field>
    <statement name="DO">
      <block type="lexical_variable_set" id="set_loaded_url">
        <field name="VAR">global server_url</field>
        <value name="VALUE">
          <block type="component_method" id="call_db_get">
            <mutation component_type="TinyDB" method_name="GetValue" is_generic="false" instance_name="TinyDB1"></mutation>
            <field name="COMPONENT_SELECTOR">TinyDB1</field>
            <value name="ARG0">
              <block type="text" id="tag_ip">
                <field name="TEXT">server_url</field>
              </block>
            </value>
            <value name="ARG1">
              <block type="text" id="default_ip">
                <field name="TEXT">http://192.168.1.100:5000</field>
              </block>
            </value>
          </block>
        </value>
        <next>
          <block type="component_set_get" id="set_box_ip">
            <mutation component_type="TextBox" set_or_get="set" property_name="Text" is_generic="false" instance_name="TextBox_ServerIP"></mutation>
            <field name="COMPONENT_SELECTOR">TextBox_ServerIP</field>
            <field name="PROP">Text</field>
            <value name="VALUE">
              <block type="lexical_variable_get" id="get_url_for_box">
                <field name="VAR">global server_url</field>
              </block>
            </value>
            <next>
              <block type="procedures_callnoreturn" id="call_initial_status">
                <mutation name="requestStatus"></mutation>
                <field name="PROCNAME">requestStatus</field>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="component_event" id="save_ip_click" x="20" y="660">
    <mutation component_type="Button" is_generic="false" instance_name="Button_SaveIP" event_name="Click"></mutation>
    <field name="COMPONENT_SELECTOR">Button_SaveIP</field>
    <statement name="DO">
      <block type="lexical_variable_set" id="update_srv_url">
        <field name="VAR">global server_url</field>
        <value name="VALUE">
          <block type="component_set_get" id="get_text_from_box">
            <mutation component_type="TextBox" set_or_get="get" property_name="Text" is_generic="false" instance_name="TextBox_ServerIP"></mutation>
            <field name="COMPONENT_SELECTOR">TextBox_ServerIP</field>
            <field name="PROP">Text</field>
          </block>
        </value>
        <next>
          <block type="component_method" id="save_to_tinydb">
            <mutation component_type="TinyDB" method_name="StoreValue" is_generic="false" instance_name="TinyDB1"></mutation>
            <field name="COMPONENT_SELECTOR">TinyDB1</field>
            <value name="ARG0">
              <block type="text" id="store_tag">
                <field name="TEXT">server_url</field>
              </block>
            </value>
            <value name="ARG1">
              <block type="lexical_variable_get" id="store_val">
                <field name="VAR">global server_url</field>
              </block>
            </value>
            <next>
              <block type="component_method" id="show_saved_alert">
                <mutation component_type="Notifier" method_name="ShowAlert" is_generic="false" instance_name="Notifier1"></mutation>
                <field name="COMPONENT_SELECTOR">Notifier1</field>
                <value name="ARG0">
                  <block type="text" id="alert_saved_msg">
                    <field name="TEXT">Server URL Saved!</field>
                  </block>
                </value>
                <next>
                  <block type="procedures_callnoreturn" id="call_req_after_save">
                    <mutation name="requestStatus"></mutation>
                    <field name="PROCNAME">requestStatus</field>
                  </block>
                </next>
              </block>
            </next>
          </block>
        </next>
      </block>
    </statement>
  </block>

  <block type="component_event" id="clock_timer_event" x="20" y="900">
    <mutation component_type="Clock" is_generic="false" instance_name="Clock1" event_name="Timer"></mutation>
    <field name="COMPONENT_SELECTOR">Clock1</field>
    <statement name="DO">
      <block type="procedures_callnoreturn" id="call_req_timer">
        <mutation name="requestStatus"></mutation>
        <field name="PROCNAME">requestStatus</field>
      </block>
    </statement>
  </block>

  <block type="component_event" id="refresh_click" x="20" y="1000">
    <mutation component_type="Button" is_generic="false" instance_name="Button_Refresh" event_name="Click"></mutation>
