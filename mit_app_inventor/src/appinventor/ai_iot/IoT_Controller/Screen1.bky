  <block type="component_event" id="web_got_text" x="900" y="20">
    <mutation component_type="Web" is_generic="false" instance_name="Web1" event_name="GotText"></mutation>
    <field name="COMPONENT_SELECTOR">Web1</field>
    <statement name="DO">
      <block type="controls_if" id="check_code_200">
        <value name="IF0">
          <block type="math_compare" id="cmp_200">
            <field name="OP">EQ</field>
            <value name="A">
              <block type="lexical_variable_get" id="get_resp_code">
                <field name="VAR">responseCode</field>
              </block>
            </value>
            <value name="B">
              <block type="math_number" id="num_200">
                <field name="NUM">200</field>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="local_declaration_statement" id="local_json">
            <mutation>
              <var name="data"></var>
            </mutation>
            <field name="VAR0">data</field>
            <value name="DECL0">
              <block type="component_method" id="call_json_decode">
                <mutation component_type="Web" method_name="JsonTextDecode" is_generic="false" instance_name="Web1"></mutation>
                <field name="COMPONENT_SELECTOR">Web1</field>
                <value name="ARG0">
                  <block type="lexical_variable_get" id="get_resp_content">
                    <field name="VAR">responseContent</field>
                  </block>
                </value>
              </block>
            </value>
            <statement name="STACK">
              <block type="component_set_get" id="set_mqtt_label">
                <mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Label_MqttStatus"></mutation>
                <field name="COMPONENT_SELECTOR">Label_MqttStatus</field>
                <field name="PROP">Text</field>
                <value name="VALUE">
                  <block type="text_join" id="join_mqtt_str">
                    <mutation items="2"></mutation>
                    <value name="ADD0">
                      <block type="text" id="txt_mqtt_prefix">
                        <field name="TEXT">📡 MQTT Broker: </field>
                      </block>
                    </value>
                    <value name="ADD1">
                      <block type="dictionaries_lookup_in_dictionary" id="dict_get_mqtt">
                        <value name="KEY">
                          <block type="text" id="k_mqtt">
                            <field name="TEXT">mqtt</field>
                          </block>
                        </value>
                        <value name="DICT">
                          <block type="lexical_variable_get" id="get_data_dict1">
                            <field name="VAR">data</field>
                          </block>
                        </value>
                        <value name="NOTFOUND">
                          <block type="text" id="nf_mqtt">
                            <field name="TEXT">Unknown</field>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </value>
                <next>
                  <block type="component_set_get" id="set_ard_label">
                    <mutation component_type="Label" set_or_get="set" property_name="Text" is_generic="false" instance_name="Label_ArduinoStatus"></mutation>
                    <field name="COMPONENT_SELECTOR">Label_ArduinoStatus</field>
                    <field name="PROP">Text</field>
                    <value name="VALUE">
                      <block type="text_join" id="join_ard_str">
                        <mutation items="2"></mutation>
                        <value name="ADD0">
                          <block type="text" id="txt_ard_prefix">
                            <field name="TEXT">⚡ Arduino Uno: </field>
                          </block>
                        </value>
                        <value name="ADD1">
                          <block type="dictionaries_lookup_in_dictionary" id="dict_get_ard">
                            <value name="KEY">
                              <block type="text" id="k_ard">
                                <field name="TEXT">arduino</field>
                              </block>
                            </value>
                            <value name="DICT">
                              <block type="lexical_variable_get" id="get_data_dict2">
                                <field name="VAR">data</field>
                              </block>
                            </value>
                            <value name="NOTFOUND">
                              <block type="text" id="nf_ard">
                                <field name="TEXT">Unknown</field>
                              </block>
                            </value>
                          </block>
                        </value>
                      </block>
                    </value>
                  </block>
                </next>
              </block>
            </statement>
          </block>
        </statement>
      </block>
    </statement>
  </block>
</xml>
